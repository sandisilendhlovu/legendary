{% extends 'base.html.twig' %}

{% block title %}Welcome{% endblock %}

{% block body %}
<div class="d-flex" style="min-height: 100vh;">

  <!-- Sidebar -->
  <nav class="bg-dark text-white p-3" style="width: 230px;">
    <ul class="nav flex-column">
      <li class="nav-item mb-4"><a href="#" class="nav-link text-white">Home</a></li>
      <li class="nav-item mb-4"><a href="{{ path('troubleshooting_index') }}" class="nav-link text-white">Troubleshooting</a></li>
      <li class="nav-item mb-4"><a href="#" class="nav-link text-white">Devices</a></li>
      <li class="nav-item mb-4"><a href="#" class="nav-link text-white">New Flows</a></li>
      <li class="nav-item mb-4"><a href="#" class="nav-link text-white">Admin</a></li>
     </ul>
     </nav>


    <!-- Main Content Area -->
    <div class="flex-grow-1 bg-light">

<!-- Top Navigation Bar -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm px-5 py-3">
  <div class="container-fluid d-flex justify-content-start">
    <ul class="navbar-nav gap-4">
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'airmobile' }) }}">AirMobile</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'wireless' }) }}">Wireless</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'dsl' }) }}">DSL</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'fibre-orders' }) }}">Fibre (Orders)</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'fibre-technical' }) }}">Fibre (Technical)</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'voip' }) }}">VoIP</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'hosting' }) }}">Hosting</a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold" href="{{ path('troubleshooting_product', { product: 'accounts' }) }}">Accounts</a>
        </li>
    </ul>
  </div>
</nav>

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
  <div style="text-align: center;">
    {% if app.user %}
      <h1>Welcome back, {{ (app.user.firstName ?? app.user.email)|capitalize }}!</h1>
    {% else %}
      <h1>Hello, Guest!</h1>
    {% endif %}
    <p>You’re now logged into Legendary</p>
    <a href="{{ path('auth_logout') }}" class="btn btn-primary mt-3">Logout</a>
  </div>
</div>
</div>
{% endblock %}
