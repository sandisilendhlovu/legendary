{% extends 'base.html.twig' %}

{% block title %}{{ flow.title }}{% endblock %}

{% block body %}
<div class="container py-5">

    <h1 class="mb-3">{{ flow.title }}</h1>
    <p class="text-muted">{{ flow.description }}</p>

    <hr class="my-4">

    <h4 class="mt-4">
        {{ step.stepNumber }}. {{ step.title }}
    </h4>

    <p>{{ step.content|raw }}</p>


    {% if options is not empty %}
        <div class="mt-4">
            <h5>Choose an option:</h5>

            {% for option in options %}
                {% if option.nextStep %}
            <a href="{{ path('flow_view', {
                flow_id: flow.id,
                step: option.nextStep.stepNumber
            }) }}"
               class="btn btn-outline-danger m-1">
                        {{ option.label }}
                    </a>
                {% else %}
                    {# END FLOW option (nextStep is null) #}
                    <a href="{{ path('flow_complete', { flow_id: flow.id }) }}"
                       class="btn btn-outline-secondary m-1">
                        {{ option.label }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    {% else %}

    <div class="mt-4 d-flex gap-3 justify-content-center">

        <!-- Start Over: go back to Fibre Technical issue selection -->
        <a href="{{ path('troubleshooting_product', { product: 'fibre-technical' }) }}"
           class="btn btn-primary px-4 py-2">
            Start Over
        </a>

        <!-- Exit Flow: go back to main homepage -->
        <a href="{{ path('home') }}"
           class="btn btn-outline-secondary px-4 py-2">
            Exit Flow
        </a>

    </div>
{% endif %}
</div>
{% endblock %}
